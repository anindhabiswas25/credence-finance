{
  "name": "@credence/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Credence public API (Build Guide \u00a710.4): Hono on Node 24, zod, OpenAPI at /v1/openapi.json.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@credence/sdk": "workspace:*",
    "@hono/node-server": "1.19.17",
    "@hono/zod-openapi": "1.6.3",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.9",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "prom-client": "15.1.3",
    "viem": "2.56.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@credence/config": "workspace:*",
    "@types/node": "24.19.0",
    "eslint": "9.39.5",
    "typescript": "~6.0.0",
    "vitest": "3.2.7"
  }
}
