{
  "name": "@credence/notifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Credence notifier (Build Guide §10.5): app.notification_job queue consumer (FOR UPDATE SKIP LOCKED) with Resend email, VAPID Web Push and Telegram, dedupe, retries and dead-lettering.",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "vitest run test/e2e.test.ts"
  },
  "dependencies": {
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "prom-client": "15.1.3",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@credence/config": "workspace:*",
    "@types/node": "24.19.0",
    "@types/web-push": "3.6.4",
    "eslint": "9.39.5",
    "http_ece": "1.2.1",
    "typescript": "~6.0.0",
    "vitest": "3.2.7"
  }
}
