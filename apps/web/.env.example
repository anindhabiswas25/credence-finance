# Credence API (services/api). The web app proxies /v1/* to it.
CREDENCE_API_URL=http://localhost:8787
# WalletConnect / Reown project id (free at cloud.reown.com). Without it, browser-extension wallets still work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional RPC overrides.
NEXT_PUBLIC_RPC_46630=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_RPC_421614=https://sepolia-rollup.arbitrum.io/rpc
