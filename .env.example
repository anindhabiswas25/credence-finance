# Credence Finance environment (Build Guide §12.1). Copy to `.env` (git-ignored) and fill in.
# Never commit secrets. In every real deployment signing keys live in AWS KMS; *_KEY_FILE and
# *_PRIVATE_KEY are accepted only on local dev chains (31337 anvil, 412346 nitro-devnode).

# ── chain ──
# 421614 = Arbitrum Sepolia; 412346 = local nitro-devnode (make infra-up); 31337 = anvil
CHAIN_ID=412346
ARB_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/<key>
ARB_SEPOLIA_RPC_URL_FALLBACK=https://<quicknode-endpoint>
ARB_SEPOLIA_WS_URL=wss://arb-sepolia.g.alchemy.com/v2/<key>
# Services use RPC_URL / RPC_URL_FALLBACK when set (local runs), else the ARB_SEPOLIA_* values.
RPC_URL=http://127.0.0.1:8547
RPC_URL_FALLBACK=
ARBISCAN_API_KEY=
# Address book (§13.2). Local deploys write deployments/<chainId>.local.json, which is used when present.
DEPLOYMENTS_FILE=deployments/421614.json

# ── deployer (CI only; hardware wallet or KMS; never a plaintext key on a laptop) ──
DEPLOYER_KMS_KEY_ID=
GOV_SAFE=0x...            # 3-of-5
GUARDIAN_SAFE=0x...       # 2-of-4
OPS_ISSUER_SAFE=0x...     # testnet issuer of test collateral
TIMELOCK_DELAY_SECONDS=3600

# ── relayer (per feed: A or B; ADR-0002: feed A = Polygon/Massive, feed B = Alpaca) ──
FEED_ID=A
# polygon | alpaca | replay (replay is refused on any non-dev chain)
VENDOR=polygon
# Generic key slot from §12.1: the Polygon key, or "<keyId>:<secret>" for Alpaca. The explicit
# variables below win when set.
VENDOR_API_KEY=
POLYGON_API_KEY=                 # https://massive.com/dashboard/signup → API Keys
POLYGON_BASE_URL=https://api.polygon.io
POLYGON_MAX_RPM=5                # Basic (free) plan: 5 req/min; paid plans: raise (e.g. 6000)
ALPACA_API_KEY_ID=               # https://app.alpaca.markets → Paper account → API Keys
ALPACA_API_SECRET_KEY=
ALPACA_FEED=iex                  # iex (free Basic) | sip (Algo Trader Plus, required for production)
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_TRADING_URL=https://paper-api.alpaca.markets
ALPACA_MAX_RPM=200
NASDAQ_HALTS_URL=https://www.nasdaqtrader.com/rss.aspx?feed=tradehalts
ASSETS=NVDA:XNAS,AAPL:XNAS,TSLA:XNAS,COIN:XNAS,MSFT:XNAS,SPY:ARCX
# CredencePriceFeed this relayer writes, and the other feed (for the vendor-disagreement metric)
FEED_ADDRESS=0x...
OTHER_FEED_ADDRESS=
# Signer node (`credence-relayer node`): its committee key
NODE_ID=node-1
NODE_LISTEN=127.0.0.1:8080
RELAYER_NODE_KMS_KEY_ID=
# Aggregator (`credence-relayer aggregator`)
RELAYER_AGGREGATOR_URL=http://aggregator-a:8080
RELAYER_NODE_URLS=http://node-a1:8080,http://node-a2:8080,http://node-a3:8080
RELAYER_NODE_TOKEN=              # shared bearer token between aggregator and nodes (required off dev chains, >= 32 bytes; OFF-02)
RELAYER_SUBMITTER_KMS_KEY_ID=    # gas-paying hot wallet (monitored by keeper J12)
RELAYER_COMMITTEE=               # optional: comma-separated committee addresses (others' signatures ignored)
RELAYER_THRESHOLD=2
RELAYER_TICK_MS=250               # aggregator tick; idle ticks only collect snapshots
RELAYER_POLL_MS=2000              # REST poll (fallback path when the stream is down)
# WebSocket streaming (S2): trades, quotes, LULD / trading status pushed by the vendor; REST is the fallback
RELAYER_STREAM=1                  # 0 = REST polling only
RELAYER_STATUS_TTL_MS=5000        # REST market-status cache while streaming
POLYGON_WS_URL=wss://socket.polygon.io/stocks          # real time needs Stocks Advanced / Business
ALPACA_STREAM_URL=wss://stream.data.alpaca.markets/v2  # + /$ALPACA_FEED (iex | sip)
RELAYER_PRINT_POLL_MS=2000
# Dev only (dev chains): RELAYER_NODE{1,2,3}_KEY_FILE / RELAYER_SUBMITTER_KEY_FILE (chmod 600)
# Replay vendor (dev): a recorded session and its speed
REPLAY_FILE=target/replay-sample.jsonl   # `credence-relayer sample-replay --out …` writes a synthetic one
REPLAY_SPEED=1
REPLAY_START_OFFSET_S=0            # start the replay this many (recording) seconds in
CALENDAR_FILES=                  # default: newest calibration/out/calendars/XNYS-*.json (+USBANK-* for the keeper)

# ── keeper ──
KEEPER_KMS_KEY_ID=
# Signers (ADR-0014): one key per chain and role. Free default: an encrypted keystore (Web3 Secret Storage v3, what
# `cast wallet import` writes) at $KEYSTORE_DIR/<chainId>/<role>.json with its password in <role>.password (both
# chmod 600, owned by the service user). Roles: keeper, relayer-<feed>-submitter, relayer-<feed>-<nodeId>,
# solver-<name>. Or <PREFIX>_KEYSTORE (+ _KEYSTORE_PASSWORD_FILE), or <PREFIX>_KMS_KEY_ID. Plain keys: dev chains only.
KEYSTORE_DIR=
KEEPER_INSTANCE_ID=keeper-eu-1
DATABASE_URL=postgres://credence:credence@127.0.0.1:5433/credence
CLOCK_ADDRESS=                   # default: shared.clock from the address book
KEEPER_ASSETS=                   # default: ASSETS + TBILL:USBANK
KEEPER_LOOKBACK_S=900
KEEPER_MIN_BALANCE_WEI=50000000000000000
KEEPER_MAX_FEE_GWEI=             # OFF-09: ceiling on replacement fees (gwei); empty = uncapped
KEEPER_NAV=1                     # J10 NAV settlement when nav.settlement is in the book
WATCH_WALLETS=                   # label=0xaddr,… (relayer hot wallets) for J12 balance alerts
SIGMA_COMMITTEE_URLS=https://sig1...,https://sig2...,https://sig3...
ALERT_WEBHOOK_URL=               # PagerDuty / Opsgenie
METRICS_ADDR=0.0.0.0:9102        # relayer default 9101, keeper 9102

# ── indexer / api / notifier ──
PONDER_CHAIN_ID=412346
PONDER_RPC_URL_421614=
PONDER_WS_URL_421614=
PONDER_RPC_URL=                  # local override (default http://127.0.0.1:8547)
DATABASE_SCHEMA=indexer
INDEXER_SCHEMA=indexer           # the Ponder views schema the API reads
API_PORT=8787
API_PUBLIC_ORIGIN=https://testnet.credence.finance
CORS_ORIGINS=                    # comma-separated allowlist (default: API_PUBLIC_ORIGIN)
SIWE_DOMAIN=testnet.credence.finance
SESSION_SECRET=                  # ≥ 32 random characters
RATE_LIMIT_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=20
TRUSTED_PROXIES=                 # OFF-03: our reverse proxies; X-Forwarded-For is trusted only from these peers
RESEND_API_KEY=                  # a channel without credentials is disabled
RESEND_API_URL=https://api.resend.com
NOTIFIER_EMAIL_FROM=Credence <alerts@credence.finance>
VAPID_PUBLIC_KEY=                # npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@credence.finance
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_URL=https://api.telegram.org
NOTIFIER_PORT=9103               # /healthz /readyz /metrics
NOTIFIER_BATCH=20
NOTIFIER_POLL_MS=1000            # safety poll; LISTEN notification_job wakes it on insert
NOTIFIER_MAX_ATTEMPTS=6          # then dead-lettered (status 'dead')
NOTIFIER_BACKOFF_BASE_S=30       # attempt k waits base × 2^(k−1), capped
NOTIFIER_BACKOFF_MAX_S=3600
NOTIFIER_LOCK_TIMEOUT_S=120      # a job left 'sending' by a dead worker is reclaimed after this

# ── local infra ──
POSTGRES_PORT=5433
DEVNODE_PORT=8547
NITRO_NODE_VERSION=v3.7.1-926f1ab

# ── web ──
NEXT_PUBLIC_CHAIN_ID=421614
NEXT_PUBLIC_API_URL=https://api.testnet.credence.finance
NEXT_PUBLIC_WS_URL=wss://api.testnet.credence.finance/v1/stream
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
