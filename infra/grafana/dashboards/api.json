{
  "uid": "credence-api",
  "title": "Credence \u00b7 API latency",
  "tags": [
    "credence",
    "api",
    "notifier"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99 by route",
      "datasource": {
        "type": "prometheus",
        "uid": "credence-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credence-prom"
          },
          "expr": "histogram_quantile(0.5, sum by (le, route) (rate(credence_api_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{route}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "credence-prom"
          },
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(credence_api_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{route}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "credence-prom"
          },
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(credence_api_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests by route and status",
      "datasource": {
        "type": "prometheus",
        "uid": "credence-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credence-prom"
          },
          "expr": "sum by (route, status) (rate(credence_api_http_requests_total[5m]))",
          "legendFormat": "{{route}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "credence-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credence-prom"
          },
          "expr": "sum(rate(credence_api_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(credence_api_http_requests_total[5m]))",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Notifier: queue depth / oldest due",
      "datasource": {
        "type": "prometheus",
        "uid": "credence-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credence-prom"
          },
          "expr": "credence_notifier_queue_depth",
          "legendFormat": "depth {{status}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "credence-prom"
          },
          "expr": "credence_notifier_oldest_due_seconds",
          "legendFormat": "oldest due (s)"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Notifier deliveries",
      "datasource": {
        "type": "prometheus",
        "uid": "credence-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credence-prom"
          },
          "expr": "sum by (channel, result) (rate(credence_notifier_deliveries_total[5m]))",
          "legendFormat": "{{channel}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    }
  ],
  "editable": false,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
