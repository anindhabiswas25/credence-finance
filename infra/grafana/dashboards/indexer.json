{
  "uid": "credence-indexer",
  "title": "Credence \u00b7 Indexer lag",
  "tags": [
    "credence",
    "indexer"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Indexer lag behind wall clock",
      "datasource": {
        "type": "prometheus",
        "uid": "credence-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credence-prom"
          },
          "expr": "time() - ponder_indexing_timestamp",
          "legendFormat": "{{chain}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Indexer lag behind the synced head",
      "datasource": {
        "type": "prometheus",
        "uid": "credence-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credence-prom"
          },
          "expr": "ponder_sync_block_timestamp - on (chain) ponder_indexing_timestamp",
          "legendFormat": "{{chain}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Synced block",
      "datasource": {
        "type": "prometheus",
        "uid": "credence-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credence-prom"
          },
          "expr": "ponder_sync_block",
          "legendFormat": "{{chain}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Events indexed",
      "datasource": {
        "type": "prometheus",
        "uid": "credence-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credence-prom"
          },
          "expr": "sum by (event) (rate(ponder_indexing_completed_events[5m]))",
          "legendFormat": "{{event}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Realtime latency p95",
      "datasource": {
        "type": "prometheus",
        "uid": "credence-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credence-prom"
          },
          "expr": "histogram_quantile(0.95, sum by (le, chain) (rate(ponder_realtime_latency_bucket[5m])))",
          "legendFormat": "{{chain}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Indexing RPC requests (state reads, ADR-0011)",
      "datasource": {
        "type": "prometheus",
        "uid": "credence-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credence-prom"
          },
          "expr": "sum by (method) (rate(ponder_indexing_rpc_requests_total[5m]))",
          "legendFormat": "{{method}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    }
  ],
  "editable": false,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
