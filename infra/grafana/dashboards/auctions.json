{
  "uid": "credence-auctions",
  "title": "Credence \u00b7 Bell, reopen and auctions",
  "tags": [
    "credence",
    "auctions"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": false,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Bell not enforced (NEEDS_ACTION at bellAt + 10 min)",
      "datasource": {
        "type": "prometheus",
        "uid": "credence-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credence-prom"
          },
          "expr": "keeper_bell_unenforced_positions",
          "legendFormat": "{{asset}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "REOPEN pending since the open print (alert > 15 min)",
      "datasource": {
        "type": "prometheus",
        "uid": "credence-prom"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credence-prom"
          },
          "expr": "keeper_reopen_pending_seconds",
          "legendFormat": "{{asset}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 420
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Bell offsets from AssetClock",
      "datasource": {
        "type": "prometheus",
        "uid": "credence-prom"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credence-prom"
          },
          "expr": "keeper_bell_lead_seconds",
          "legendFormat": "{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "J3 / J4 / J5 / J6 / J10 jobs",
      "datasource": {
        "type": "prometheus",
        "uid": "credence-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credence-prom"
          },
          "expr": "sum by (job, result) (increase(keeper_jobs_total{job=~\"J3|J4|J5|J6|J10\"}[15m]))",
          "legendFormat": "{{job}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Keeper txs by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "credence-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credence-prom"
          },
          "expr": "sum by (outcome) (increase(keeper_txs_total[15m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Stuck txs replaced",
      "datasource": {
        "type": "prometheus",
        "uid": "credence-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credence-prom"
          },
          "expr": "sum by (job) (increase(keeper_tx_replacements_total[1h]))",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Keeper txs reverted",
      "datasource": {
        "type": "prometheus",
        "uid": "credence-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "credence-prom"
          },
          "expr": "sum by (job) (increase(keeper_failed_txs_total{reason=\"reverted\"}[1h]))",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
