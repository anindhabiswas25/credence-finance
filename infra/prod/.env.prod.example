# The local testnet stack's non-secret settings (`make ops-secrets-init` copies this to infra/prod/.env.prod).
# Secrets are never here: they are 0600 files in infra/prod/secrets (RPC keys, Postgres, session, webhook, tokens).

# Image tag the stack runs (make services-deploy TAG=… builds and switches; services-rollback goes back)
TAG=latest
# The service keystores (A's make testnet-keys): KEYS_DIR/<chainId>/<role>.json + .password, 0600
KEYS_DIR=${HOME}/.credence/keys
# The address(es) whose SIWE session may read the ops inbox (GET /v1/ops/alerts, the `ops` stream topic)
OPS_ADMIN_ADDRESSES=
# The frontend that calls the API (CORS, SIWE domain)
FRONTEND_ORIGIN=http://localhost:3000
SIWE_DOMAIN=localhost:3000
# Host ports (127.0.0.1 only)
API_PORT=8787
GRAFANA_PORT=13001
PROMETHEUS_PORT=19090
ALERTMANAGER_PORT=19093
# Nightly backup (UTC; 20:30 UTC = 02:00 IST) and retention
BACKUP_AT_UTC=20:30
BACKUP_KEEP_DAYS=14
# The nav-strike timer: seconds after each USBANK session opens
NAVSTRIKE_OFFSET_S=1800
RUST_LOG=info

# Indexers on free RPC plans (defaults in docker-compose.yml): RPC tiers they use (no Chainstack: it refuses
# non-recent eth_getLogs), Ponder's request rate per chain, and an optional fixed eth_getLogs block range.
# PONDER_RPC_TIERS="PRIMARY PUBLIC"
# PONDER_MAX_REQUESTS_PER_SECOND=10
# PONDER_ETH_GET_LOGS_BLOCK_RANGE=
